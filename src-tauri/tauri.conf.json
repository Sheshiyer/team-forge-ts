{
  "productName": "TeamForge",
  "version": "0.4.0",
  "identifier": "com.thoughtseed.teamforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TeamForge — Command Cortex",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' http://127.0.0.1:3101 http://127.0.0.1:3131 https://teamforge-api.sheshnarayan-iyer.workers.dev; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; form-action 'none'; frame-ancestors 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      },
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Thoughtseed Private Limited (BS6SZR4929)"
    },
    "category": "public.app-category.business",
    "shortDescription": "Command Cortex for agentic team operations and project orchestration",
    "longDescription": "TeamForge unifies Paperclip agents, Clockify time tracking, Huly execution workflows, GitHub review gates, and a Cloudflare-backed project control plane into a single native Mac command cortex.",
    "copyright": "Copyright 2026 Thoughtseed",
    "publisher": "Thoughtseed",
    "homepage": "https://github.com/Sheshiyer/team-forge-ts",
    "resources": {
      "../scripts/teamforge-vault-parity.mjs": "teamforge-vault-parity.mjs",
      "../scripts/launch-thoughtseed-paperclip.sh": "launch-thoughtseed-paperclip.sh",
      "../scripts/paperclip-runtime-adapter.mjs": "paperclip-runtime-adapter.mjs"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5Njg0NkU1NkQzNEE2RjMKUldUenBqUnQ1VVpvV1VDTnJhYUw5Y2ZuTVNqNXJ3czRibHZkT2dBUGhRSWVyN004WndtQXdFYU0K",
      "endpoints": [
        "https://teamforge-api.sheshnarayan-iyer.workers.dev/v1/ota/check?target={{target}}&currentVersion={{current_version}}&channel=stable"
      ]
    }
  }
}
