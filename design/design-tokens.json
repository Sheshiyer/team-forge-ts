      "default": { "value": "#F87060", "description": "Primary accent - Desert Sand" },
      "soft": { "value": "rgba(248, 112, 96, 0.7)" },
      "glow": { "value": "rgba(248, 112, 96, 0.15)" }
    },
    "gold": {
      "default": { "value": "#E1BB80", "description": "Secondary accent - Ecru" },
